"\n"
".SUBCKT UCC28C43_START  COMP   FB   CS   RTCT    GND    OUT   VDD   VREF  \n"
"****OSCILLATOR*****\n"
"STOF1 8 GND RTCT GND SOSC\n"
"GBDISCH RTCT GND Value = { IF ( V(8,GND) < 2.5 & V(13,GND) > 2.5, 8.4M, 0 ) }"
"\n"
"RPULL 8 VREF 100K\n"
"STOF2 VDD 19 VDD GND SUVLO\n"
"RUVLO 19 GND 1MEG\n"
"RSTDBY VDD GND 309K \n"
"ROP 10 GND 2535 \n"
"EBREF 13 GND Value = { IF ( V(19,GND) > 6, 5, 0 ) } \n"
"RREG 10 VREF 0.158\n"
"CREF VREF GND 1N\n"
"V3 13 10 0\n"
"GB6 19 GND Value = { IF (V(19,GND) > 4 , IF((I(V3)-I(EMY19))>10e-3,  10e-3, I"
"F((I(V3)-I(EMY19))<0, 0,(I(V3)-I(EMY19)))), 0 ) }\n"
"EB3 21 GND Value = { IF ( V(CS,GND) > V(16,GND), 5, 0 ) }\n"
"R7 CS GND 1MEG\n"
"RDELAY 21 22 1K\n"
"CDELAY 22 GND 200P\n"
"XAMP VREF FB COMP GND 28C4xAMP\n"
"R4 12 11 2MEG\n"
"R6 11 GND 1MEG\n"
"EB2 16 GND Value = { IF ( V(11,GND) > 1, 1, V(11,GND) ) }\n"
"V4 COMP 9 1\n"
"D1 9 12 D2\n"
"EMY19 191 GND VALUE = {V(19,GND)} \n"
"XDRIVE 191 GND 5 OUT FETOUTC4X \n"
"XLATCH 8 VREF 22 GND 6 7 FFLOPC2\n"
"EOut 5 GND Value = { IF ( V(VREF,GND) > 2.5 & V(7,GND) >  2.5 & V(8,GND) > 2."
"5, 5, 0 ) }\n"
".MODEL SOSC VSWITCH (RON=.01 ROFF=1MEG VT=1.45 VH=0.95) \n"
".MODEL SUVLO VSWITCH (RON=.01 ROFF=5MEG VT=8.0 VH=0.4)\n"
".MODEL D2 D \n"
".ENDS UCC28C43_START\n"
"\n"
"*--------------- End of main subcircuit ----------------------\n"
"*--------------- References are appended below ---------------\n"
"\n"
".SUBCKT 28C4xAMP  4     1    9   20\n"
"R1 10 4 100K\n"
"R2 10 20 100K\n"
"R3 6 20 316MEG\n"
"C1 6 20 8.7p \n"
"E1 5 20 6 20 1\n"
"R4 1 20 50MEG \n"
"I2 4 9 1m \n"
"R6 20 3 300\n"
"Q1 20 13 9 QPMOD\n"
"I3 13 20 68U \n"
"D14 3 13 DMOD\n"
"D15 20 6 DCLAMP\n"
"L1 2 3 10U\n"
"C2 3 20 200P\n"
"R9 5 2 5\n"
"C5 2 20 0.02U\n"
"G1 20 6 10 1 100U\n"
".MODEL QPMOD PNP BF=217.647 \n"
".MODEL DCLAMP D (RS=10 BV=6.8 IBV=.01) \n"
".MODEL DMOD D\n"
".ENDS 28C4xAMP\n"
"\n"
".SUBCKT FETOUTC4X  Vcc  Gnd In Out\n"
"Rm1 Vcc Out 10MEG\n"
"M1 Vcc 3 Out Out _NMOS \n"
"Rm2 Out Gnd 10MEG\n"
"M2 Gnd 3 Out Out _PMOS \n"
"EB1 2 Out Value= { IF ( V(In,Gnd) > 2 , 5 , -5 ) }\n"
"R1 2 3 75\n"
"C2 3 Gnd 10p\n"
"C3 3 Vcc 10p\n"
"R2 3 Gnd 10Meg\n"
".MODEL _NMOS NMOS KP=1 NSUB=1E9 RD=10 VTO=3\n"
".MODEL _PMOS PMOS KP=1 RD=5.5 VTO=-3 NSUB=1E9\n"
".ENDS FETOUTC4X\n"
"\n"
".SUBCKT FFLOPC2 1  2 11 12 5  6\n"
"X1 7 4 2 8 NAND3_0C2 \n"
"X2 8 3 10 9 NAND3_0C2 \n"
"X3 1 8 10 7 NAND3_1C2 \n"
"X4 4 9 1 10 NAND3_0C2 \n"
"X5 4 7 6 5 NAND3_1C2 \n"
"X6 5 10 3 6 NAND3_0C2 \n"
"X7 11 4 INV \n"
"X8 12 3 INV \n"
".ENDS FFLOPC2\n"
"\n"
".SUBCKT INV 1 2\n"
"E1 3 0 VALUE = { IF ( V(1)>800mV, 0, 5 ) }\n"
"R1 3 2 100\n"
"C1 2 0 10P IC=3.5\n"
".ENDS INV\n"
"\n"
".SUBCKT NAND3_0C2 1 2 3 4\n"
"E1 5 0 VALUE = { IF ( (V(1)>800M) & (V(2)>800M) & (V(3)>800M), 0, 5 ) }\n"
"R1 5 4 100\n"
"C1 4 0 20P IC=0\n"
".ENDS NAND3_0C2 \n"
"\n"
".SUBCKT NAND3_1C2 1 2 3 4\n"
"E1 5 0 VALUE = { IF ( (V(1)>800M) & (V(2)>800M) & (V(3)>800M), 0, 5 ) }\n"
"R1 5 4 100\n"
"C1 4 0 20P IC=3.5\n"
".ENDS NAND3_1C2 \n"
"\n"
